<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Keep Fluent templates and their keyboard focus indicators. -->
  <Style Selector="Window">
    <Setter Property="Icon" Value="avares://SmartSQL.Desktop/Assets/SmartSQL.ico" />
    <Setter Property="Background" Value="{DynamicResource UiCanvasBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource UiTextBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
  </Style>
  <Style Selector="Window.dialog">
    <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource UiCardRadius}" />
    <Setter Property="Padding" Value="{DynamicResource UiCardPadding}" />
    <Setter Property="BoxShadow" Value="0 2 10 0 #07000000" />
  </Style>
  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="25" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource UiMutedTextBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource UiMutedTextBrush}" />
  </Style>
  <Style Selector="TextBlock.navsection">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiMutedTextBrush}" />
    <Setter Property="Margin" Value="12,16,12,8" />
  </Style>
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="{DynamicResource UiButtonPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource UiControlRadius}" />
    <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource UiTextBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UiSurfaceMutedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource UiTextBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource UiTextBrush}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource UiAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UiAccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiAccentHoverBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UiAccentHoverBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.quiet, Button.navigation, Button.navitem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.navigation, Button.navitem">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Button.navigation.active, Button.navitem.active">
    <Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource UiAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.navigation.active:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.navitem.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource UiAccentBrush}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource UiDangerBrush}" />
  </Style>
  <Style Selector="Button.iconButton">
    <Setter Property="Width" Value="36" />
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.columnHeader">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <!-- Disabled commands remain legible but recede into the warm surface. -->
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiSoftBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource UiDisabledTextBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UiAccentDisabledBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiAccentDisabledBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource UiMutedTextBrush}" />
  </Style>
  <Style Selector="Button.quiet:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.navigation:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.navitem:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="CornerRadius" Value="{DynamicResource UiControlRadius}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="CornerRadius" Value="{DynamicResource UiControlRadius}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Menu.toolbarMenu">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Menu.toolbarMenu > MenuItem, MenuItem.toolbarMenuitem">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource UiControlRadius}" />
  </Style>
  <Style Selector="MenuItem:disabled">
    <Setter Property="Foreground" Value="{DynamicResource UiDisabledTextBrush}" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="9,5" />
  </Style>
  <Style Selector="Border.iconTile">
    <Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="9" />
  </Style>
  <Style Selector="ListBox.navigation">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.navigation ListBoxItem">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="CornerRadius" Value="{DynamicResource UiControlRadius}" />
  </Style>
  <Style Selector="ListBox.navigation ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource UiAccentBrush}" />
  </Style>
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{DynamicResource UiPaperBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource UiTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RowHeight" Value="40" />
    <Setter Property="ColumnHeaderHeight" Value="44" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource UiSoftBorderBrush}" />
    <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource UiSoftBorderBrush}" />
  </Style>
  <Style Selector="DataGrid.flatgrid">
    <Setter Property="GridLinesVisibility" Value="All" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource UiSurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource UiTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="DataGridRow">
    <Setter Property="Background" Value="{DynamicResource UiPaperBrush}" />
  </Style>
  <Style Selector="DataGridRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
  </Style>
  <Style Selector="DataGridRow:selected, DataGridRow:selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="DataGridCell TextBlock#CellTextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
</Styles>
